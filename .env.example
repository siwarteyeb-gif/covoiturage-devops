# Copier ce fichier en ".env" puis remplacer les valeurs. Le fichier .env n'est JAMAIS commite.

# --- Construire les images en local avec "docker compose up --build" ---
COMPOSE_FILE=docker-compose.yml:docker-compose.build.yml
COMPOSE_PATH_SEPARATOR=:

# --- Image a lancer (registre et version). Inutile en local si on construit. ---
IMAGE_PREFIX=covoiturage
IMAGE_TAG=dev

# --- Base de donnees ---
DB_NAME=covoiturage_db
DB_USER=covoiturage
DB_PASSWORD=changez-moi-db
DB_ROOT_PASSWORD=changez-moi-root

# --- Application ---
JWT_SECRET=changez-moi-au-moins-32-caracteres-0123456789
ADMIN_EMAIL=admin@covoiturage.tn
ADMIN_PASSWORD=Changez-Moi-123
APP_PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080

# --- Options ---
ORS_API_KEY=
MAIL_ENABLED=false
